# Contact form email delivery (Resend — https://resend.com)
# Leave unset and the form falls back to the visitor's email client.
RESEND_API_KEY=
CONTACT_TO=jonathan@theabbeygroupnorfolk.com
# Must be a verified sender/domain in Resend, e.g. website@theabbeygroupnorfolk.com
CONTACT_FROM=

# Admin sign-in. Users are managed in the Users tab of /admin.
# ADMIN_PASSWORD is a recovery credential: sign in with any username and this
# password if all user accounts are lost. Unset = admin only works in local dev.
ADMIN_PASSWORD=

# Secret used to sign admin session tokens. Optional — falls back to
# SUPABASE_SERVICE_ROLE_KEY. Set a random value to keep sessions valid if the
# Supabase key is ever rotated.
AUTH_SECRET=

# Supabase (server-side store for admin CMS data + image uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
